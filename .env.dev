# ============================================================
# MTL Commerce - Development Environment (Docker)
# ============================================================

NODE_ENV=development

# Database - PostgreSQL External
DATABASE_URL=postgresql://mytholaptop_user:xxx@xxx.xxx:7000/mytholaptop

# Redis - Docker Internal
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=supersecret_dev_local_2026
COOKIE_SECRET=supersecret_dev_local_2026

# CORS
STORE_CORS=http://localhost:7004,http://localhost:8000
ADMIN_CORS=http://localhost:7003,http://localhost:7004
AUTH_CORS=http://localhost:7003,http://localhost:7004

# Cookie Options (HTTP → lax, no secure)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Backend URL cho Admin UI
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://backend:7003
