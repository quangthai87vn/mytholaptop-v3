# ============================================================
# MTL Commerce - Production Environment
# ============================================================
# Copy file này thành .env trên máy Debian trước khi chạy deploy-debian.sh
# ============================================================

NODE_ENV=production

# --- Database - PostgreSQL External (sửa theo server của bạn) ---
DATABASE_URL=postgresql://mytholaptop_user:xxx@xxx.xxx:7000/mytholaptop

# --- Redis - Docker Internal (dùng tên service trong Docker network) ---
REDIS_URL=redis://redis:6379

# --- Security ---
JWT_SECRET=supersecret_dev_local_2026
COOKIE_SECRET=supersecret_dev_local_2026

# --- CORS ---
# Danh sách domain được phép gọi API (phân cách bằng dấu phẩy)
STORE_CORS=http://localhost:7004,http://localhost:8000,https://admin.mtl.vn
ADMIN_CORS=http://localhost:7003,http://localhost:7004,https://admin.mtl.vn
AUTH_CORS=http://localhost:7003,http://localhost:7004,https://admin.mtl.vn

# --- Cookie Options ---
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=admin.mtl.vn

# --- Backend URL cho Admin UI ---
# Dùng localhost khi chạy riêng trên máy Debian
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:7003

# --- Docker Ports ---
BACKEND_PORT=7003
ADMIN_PORT=7004
