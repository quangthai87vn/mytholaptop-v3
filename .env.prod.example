# ===========================
# MTL Commerce - Production Env
# ===========================
# Copy file: cp .env.prod.example .env.prod
# Run: docker compose -f docker-compose-prod.yml --env-file .env.prod up -d

# --- Node Environment ---
NODE_ENV=production

# --- Database (PostgreSQL) ---
# Connection string đến PostgreSQL server
# Ví dụ: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://mytholaptop_user:yourpassword@your-postgres-host:5432/mytholaptop

# --- Redis ---
# Connection string đến Redis server
# Nếu chạy Redis container local, dùng: redis://redis:6379
REDIS_URL=redis://redis:6379

# --- Redis Port (optional) ---
# Port để expose Redis ra host (mặc định: 7005)
REDIS_PORT=7005

# --- Backend ---
# Cổng backend (mặc định: 7003)
BACKEND_PORT=7003

# JWT secret cho backend - NÊN đổi giá trị ngẫu nhiên
JWT_SECRET=change-me-to-a-random-secret

# Cookie secret cho backend - NÊN đổi giá trị ngẫu nhiên
COOKIE_SECRET=change-me-to-a-random-secret

# CORS cho phép (cách nhau bằng dấu phẩy)
STORE_CORS=http://localhost:8000,http://localhost:7004
ADMIN_CORS=http://localhost:5173,http://localhost:7004,https://admin.mtl.vn
AUTH_CORS=http://localhost:5173,http://localhost:7004,http://localhost:7003,http://127.0.0.1:7004,https://admin.mtl.vn

# --- Admin UI ---
# URL backend để admin-ui gọi API
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://backend.mtl.vn

# Cổng admin UI (mặc định: 7004)
ADMIN_PORT=7004
