# ============================================================
# MTL Commerce - Production Environment
# ============================================================
# Copy file này thành .env trên máy Debian trước khi chạy deploy-debian.sh
# ============================================================

NODE_ENV=production

# --- Database - PostgreSQL External (sửa theo server của bạn) ---
# Ví dụ: postgresql://user:pass@host:port/dbname
DATABASE_URL=postgresql://mytholaptop_user:YOUR_PASSWORD@YOUR_DB_HOST:7000/mytholaptop

# --- Redis - Docker Internal (tự động cài Redis container) ---
# Đổi thành Redis Cloud URL nếu dùng external
REDIS_URL=redis://redis:6379

# --- Security - ĐỔI PASSWORD NGAY! ---
JWT_SECRET=CHANGE_THIS_JWT_SECRET_2026
COOKIE_SECRET=CHANGE_THIS_COOKIE_SECRET_2026

# --- CORS - Thêm domain/IP của bạn ---
# Phân cách bằng dấu phẩy
STORE_CORS=http://localhost:7004,http://YOUR_DEBIAN_IP:7004
ADMIN_CORS=http://localhost:7003,http://localhost:7004,http://YOUR_DEBIAN_IP:7003,http://YOUR_DEBIAN_IP:7004
AUTH_CORS=http://localhost:7003,http://localhost:7004,http://YOUR_DEBIAN_IP:7003,http://YOUR_DEBIAN_IP:7004

# --- Cookie Options ---
# Dùng IP (chưa có SSL): COOKIE_SECURE=false, COOKIE_SAME_SITE=lax, COOKIE_DOMAIN rỗng
# Dùng domain có SSL: COOKIE_SECURE=true, COOKIE_SAME_SITE=none, COOKIE_DOMAIN=admin.mtl.vn
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Backend URL cho Admin UI ---
# Dùng IP Debian: http://YOUR_DEBIAN_IP:7003
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://YOUR_DEBIAN_IP:7003

# --- Docker Ports (không cần sửa) ---
BACKEND_PORT=7003
ADMIN_PORT=7004
