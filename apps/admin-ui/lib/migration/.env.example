# WooCommerce to Medusa Migration - Environment Variables
# Copy file nay thanh .env va dien thong tin cua ban
#
# LUON LUON dung WooCommerce REST API — KHONG ket noi MySQL WordPress truc tiep.
# Consumer Key/Secret tao o: WooCommerce Admin > WooCommerce > Settings > Advanced > REST API

# ===========================================
# WooCommerce REST API (bat buoc)
# ===========================================
# URL WordPress, phai chua /wp-json
WOO_API_BASE_URL=https://mytholaptop.vn/wp-json
# Consumer Key (ck_...) — tao tu WooCommerce Admin
WOO_CONSUMER_KEY=ck_your_consumer_key_here
# Consumer Secret (cs_...) — tao tu WooCommerce Admin
WOO_CONSUMER_SECRET=cs_your_consumer_secret_here

# ===========================================
# Medusa Backend
# ===========================================
# Chon 1 trong 2 cach auth:
#
# Cach 1: API Key (uu tien - neu co sk_xxx)
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_API_KEY=your_medusa_api_key_here
#
# Cach 2: JWT (dang nhap bang email/password)
# MEDUSA_ADMIN_EMAIL=admin@example.com
# MEDUSA_ADMIN_PASSWORD=your_password_here
